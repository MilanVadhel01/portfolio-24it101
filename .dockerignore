# ─────────────────────────────────────────────
# .dockerignore — frontend build context
# Keeps secrets, host dependencies and junk OUT
# of the image (and out of the build cache).
# ─────────────────────────────────────────────

# Host-installed dependencies — the image runs `npm ci`
# inside the container with the correct Linux binaries
node_modules/

# Production build output — the image builds its own dist/
dist/
build/

# Secrets — never copy .env files into the image
.env
.env.*
!.env.example

# Version control / CI
.git/
.github/
.gitignore

# Docker files themselves are not needed inside the image
Dockerfile
.dockerignore
docker-compose.yml

# Logs and coverage output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage/
.nyc_output/

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AI context / docs (not part of the app)
context.md
